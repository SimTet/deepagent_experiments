# Copy this file to .env and fill in real values:
#   cp .env_example .env
#
# GOOGLE_API_KEY - required by every example agent (they all use Gemini via
# langchain-google-genai). Create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# TAVILY_API_KEY - required only by research_agent, which uses Tavily for
# web search. Other agents ignore this value. Create a key at
# https://app.tavily.com
TAVILY_API_KEY=
